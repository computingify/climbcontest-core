[Unit]
Description=ClimbContest - backend de competition
Documentation=https://github.com/computingify/climbcontest-core/blob/master/specs/001-vm-climbcontest/architecture.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=climbcontest
Group=climbcontest
WorkingDirectory=/opt/climbcontest/current

Environment=PYTHONUNBUFFERED=1
# Secrets et reglages : cle d'API, acces au classeur, secret de session.
# Le tiret initial rend le fichier facultatif : le service demarre sans.
EnvironmentFile=-/opt/climbcontest/shared/secrets/env

# Le venv vit DANS la release (.venv), pas dans shared/ : une release qui
# s'installe ne peut pas casser l'environnement de celle qui tourne, et un
# retour arriere retrouve l'environnement exact de la version precedente.
#
# 4 workers x 4 threads = 16 requetes en parallele, pour une pointe estimee a
# 250-350 req/min dominee par les spectateurs (docs/contraintes-metier.md 3 bis).
# keep-alive 65 : les telephones reutilisent leur connexion, ce qui supprime la
# poignee de main TLS a chaque scan.
ExecStart=/opt/climbcontest/current/.venv/bin/gunicorn \
    --workers 4 --threads 4 --worker-class gthread \
    --timeout 30 --graceful-timeout 30 --keep-alive 65 \
    --bind 0.0.0.0:5007 \
    --access-logfile - --error-logfile - \
    wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID

Restart=on-failure
RestartSec=5s

# Durcissement : le service n'a besoin d'ecrire que dans shared/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/climbcontest/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
