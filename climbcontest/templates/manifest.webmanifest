{
  "name": "ClimbContest — Juge",
  "short_name": "ClimbContest",
  "description": "Scanner les reussites d'une competition de bloc.",
  {#- Spec 014. `start_url` porte le jeton quand la page qui lie ce manifeste
      en avait un : c'est ce qui fait qu'une application INSTALLEE recoit sa cle
      dans son adresse a chaque lancement, sans dependre d'un stockage local que
      l'iPhone cloisonne. Sans jeton, la valeur est celle d'avant : "/juge". -#}
  "start_url": {{ depart | tojson }},
  {#- `scope` reste NU, volontairement : c'est le perimetre de l'application,
      pas son point d'entree. Un scope porteur d'une requete restreindrait
      l'application a cette seule adresse. -#}
  "scope": "/juge",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0D11",
  "theme_color": "#0B0D11",
  "lang": "fr",
  "icons": [
    { "src": "/static/juge/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/static/juge/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/static/juge/icone-512.png", "sizes": "512x512", "type": "image/png",
      "purpose": "maskable" }
  ]
}
